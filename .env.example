# DESMAN(P) Environment Configuration
# Copy to .env and fill in your API keys
# Run `desman setup` for interactive configuration with instructions

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================

# OpenRouter — one key, dozens of free models (Llama, Gemma, Phi, Qwen, etc.)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional model override (default: meta-llama/llama-3.1-8b-instruct:free)
# Other free: google/gemma-2-9b-it:free, microsoft/phi-3-mini-128k-instruct:free
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Google AI Studio (Gemini) — generous free tier: 1500 req/day on Flash
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Groq — very fast inference, 14400 req/day free
# Get key: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# Mistral AI — European provider, open weights
# Get key: https://console.mistral.ai/api-keys/
# MISTRAL_API_KEY=your_mistral_key_here
# MISTRAL_MODEL=mistral-small-latest

# Cloudflare Workers AI — 100k req/day free, needs Account ID too
# Get key: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_KEY=your_cloudflare_key_here
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Cohere — good for RAG/embeddings, free dev tier
# Get key: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=your_cohere_key_here
# COHERE_MODEL=command-r

# NVIDIA NIM — powerful Nemotron models, free credits on signup
# Get key: https://build.nvidia.com/explore/discover
# NVIDIA_API_KEY=your_nvidia_key_here
# NVIDIA_MODEL=nvidia/nemotron-3-ultra

# Vercel AI Gateway — proxy with logging/caching, not a model provider
# Get key: https://vercel.com/dashboard/stores/ai-gateway
# VERCEL_AI_GATEWAY_KEY=your_vercel_key_here
# VERCEL_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct:free

# =============================================================================
# DATABASE
# =============================================================================
# DATABASE_URL=sqlite+aiosqlite:///data/desman.db