# DESMAN(P) Environment Configuration
# Copy to .env and fill in your API keys

# OpenRouter API Key (get from https://openrouter.ai/keys)
# Free models available: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free, etc.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Specific model to use (default: meta-llama/llama-3.1-8b-instruct:free)
# Other free options: google/gemma-2-9b-it:free, microsoft/phi-3-mini-128k-instruct:free
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Database (default: sqlite+aiosqlite:///data/desman.db)
# DATABASE_URL=sqlite+aiosqlite:///data/desman.db